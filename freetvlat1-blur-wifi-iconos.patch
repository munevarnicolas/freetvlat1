+        int ch = want < have ? src.getHeight() : Math.round(src.getWidth() / want);
+        Bitmap crop = Bitmap.createBitmap(src, (src.getWidth() - cw) / 2, (src.getHeight() - ch) / 2, cw, ch);
+        Bitmap scaled = Bitmap.createScaledBitmap(crop, w, h, true);
